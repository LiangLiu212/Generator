 Flavor     = ANY
 Qualifiers = "e26:incl634:prof"

 Action = defineFQ
   envSet(GENIE_FQ_DIR, ${UPS_PROD_DIR}/${UPS_PROD_FLAVOR}-e26-incl634-prof)

 Action = ExtraSetup
   setupRequired(boost v1_82_0 -q +e26:+prof)
   setupRequired(root v6_28_12 -q +e26:+p3915:+prof)
   setupRequired(lhapdf v6_5_5 -q +e26:+p3915:+prof)
   setupRequired(pythia8 v8_3_15 -q +e26:+p3915:+prof)
   setupRequired(libxml2 v2_9_12)
   setupRequired(log4cpp v1_1_3e -q +e26:+prof)
   setupRequired(gcc v12_1_0)
   # INCL++ v6.34 is not a UPS product: its libraries, headers and data
   # tables are shipped inside this product, in ${GENIE_FQ_DIR}/inclxx.
   envSet(INCLXX_DIR, ${GENIE_FQ_DIR}/inclxx)
   pathPrepend(PATH, ${INCLXX_DIR}/bin)
   envPrepend(LD_LIBRARY_PATH, ${INCLXX_DIR}/lib)
   # NucleusGenINCL.xml composes ${INCLXX_DATA_DIR}/data and
   # ${INCLXX_DATA_DIR}/de-excitation/...
   envSet(INCLXX_DATA_DIR, ${INCLXX_DIR}/share)

