Common:
  Action = setup
    setupEnv()
    prodDir()
    exeActionRequired(defineFQ)
    envSet(GENIE, ${GENIE_FQ_DIR}/GENIE-Generator)
    envSet(GENIE_REWEIGHT, ${GENIE_FQ_DIR}/GENIE-Reweight)
    envSet(GENIE_VERSION, ${UPS_PROD_VERSION})
    # look for the include subdirectory
    envSet(GENIE_INC, ${GENIE_FQ_DIR}/include)
    # look for the lib subdirectory
    envSet(GENIE_LIB, ${GENIE_FQ_DIR}/lib)
    if ( test `uname` = "Darwin" )
      envPrepend(DYLD_LIBRARY_PATH, ${GENIE_FQ_DIR}/lib)
    else()
      envPrepend(LD_LIBRARY_PATH, ${GENIE_FQ_DIR}/lib)
    endif ( test `uname` = "Darwin" )
    # add the bin directory to the path
    pathPrepend(PATH, ${GENIE_FQ_DIR}/bin )
    # useful variables
    envPrepend(ROOT_INCLUDE_PATH, ${GENIE_INC} )
    envPrepend(ROOT_INCLUDE_PATH, ${GENIE_INC}/GENIE )
    envPrepend(CMAKE_PREFIX_PATH, ${GENIE_FQ_DIR} )
    envPrepend(PKG_CONFIG_PATH, ${GENIE_FQ_DIR} )

    exeActionRequired(ExtraSetup)
End:
