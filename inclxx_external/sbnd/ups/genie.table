File    = table
Product = genie

# ---------------------------------------
Group:

  Flavor     = ANY
  Qualifiers = "c14:prof"

  Action = defineFQ
    envSet(GENIE_FQ_DIR, ${UPS_PROD_DIR}/${UPS_PROD_FLAVOR}-c14-prof)

  Action = ExtraSetup
    setupRequired(root v6_28_12 -q +c14:+p3915:+prof)
    setupRequired(lhapdf v6_5_5 -q +c14:+p3915:+prof)
    setupRequired(pythia8 v8_3_15 -q +c14:+p3915:+prof)
    setupRequired(libxml2 v2_9_12)
    setupRequired(log4cpp v1_1_3e -q +c14:+prof)
   setupRequired(clang v14_0_6c)

  Flavor     = ANY
  Qualifiers = "c14:geant4:prof"

  Action = defineFQ
    envSet(GENIE_FQ_DIR, ${UPS_PROD_DIR}/${UPS_PROD_FLAVOR}-c14-geant4-prof)

  Action = ExtraSetup
    setupRequired(geant4 v4_10_6_p01g -q +c14:+prof)
    setupRequired(root v6_28_12 -q +c14:+p3915:+prof)
    setupRequired(lhapdf v6_5_5 -q +c14:+p3915:+prof)
    setupRequired(pythia8 v8_3_15 -q +c14:+p3915:+prof)
    setupRequired(libxml2 v2_9_12)
    setupRequired(log4cpp v1_1_3e -q +c14:+prof)
    setupRequired(clang v14_0_6c)

