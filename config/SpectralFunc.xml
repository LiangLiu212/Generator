<?xml version="1.0" encoding="ISO-8859-1"?>

<alg_conf>

<!--
Configuration for the SpectralFunc NuclearModelI implementation

Configurable Parameters:
....................................................................................................................................
Name                    Type     Optional   Comment                                        Default
....................................................................................................................................
FermiMomentumTable      string   No         Table of Fermi momentum (kF) constants         CommonParam[FermiGas]                                                                                      

-->

  <param_set name="Default"> 

    <param type="string" name="CommonParam"> FermiGas </param>

    <!-- The data file path may be specified relative to the GENIE root folder or
       as an absolute path -->
    <param type="string" name="DataPathType"> relative </param>
    <param type="string" name="DataPath"> data/evgen/nucl/spectral_functions </param>

    <!-- <param type="string" name="SpectFuncTable@Pdg=1000060120"> benhar-sf-12c.data </param> -->
    <param type="string" name="SpectFuncTable@Pdg=1000060120_2212"> pke12_tot.data </param>
    <param type="string" name="SpectFuncTable@Pdg=1000060120_2112"> pke12_tot.data </param>
    <param type="string" name="SpectFuncTable@Pdg=1000080160_2212"> pke16_tot.data </param>
    <param type="string" name="SpectFuncTable@Pdg=1000080160_2112"> pke16_tot.data </param>
    <param type="string" name="SpectFuncTable@Pdg=1000260560_2212"> benhar-sf-56fe.data </param>
    <param type="string" name="SpectFuncTable@Pdg=1000260560_2112"> benhar-sf-56fe.data </param>
    <param type="string" name="SpectFuncTable@Pdg=1000180400_2212"> pke40p_tot.data </param>
    <param type="string" name="SpectFuncTable@Pdg=1000180400_2112"> pke40n_tot.data </param>

  </param_set>

  <!-- Mean-field part only of the spectral function (the correlated part removed).
       Needed by the one-body / two-body current interference of genie::UnifiedQELPXSec.
       pke12_MF.data: CBF 12C mean-field spectral function (normalised to 5.135 of 6
       nucleons) as distributed with ACHILLES (data/Spectral_Functions/pke12p_MF.data,
       identical for protons and neutrons), in the header format of pke12_tot.data -->
  <param_set name="MeanField">
    <param type="string" name="CommonParam"> FermiGas </param>
    <param type="string" name="DataPathType"> relative </param>
    <param type="string" name="DataPath"> data/evgen/nucl/spectral_functions </param>
    <param type="string" name="SpectFuncTable@Pdg=1000060120_2212"> pke12_MF.data </param>
    <param type="string" name="SpectFuncTable@Pdg=1000060120_2112"> pke12_MF.data </param>
  </param_set>

</alg_conf>
